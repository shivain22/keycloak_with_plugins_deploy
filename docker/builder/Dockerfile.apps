FROM node:20-bookworm-slim

# Install build dependencies: git, Java 17, Maven
# Note: Jib doesn't require Docker CLI - it builds images directly
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    openjdk-17-jdk-headless \
    maven \
    bash \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /work

# Copy build script into image
COPY build-apps.sh /usr/local/bin/build-apps.sh
RUN chmod +x /usr/local/bin/build-apps.sh

ENTRYPOINT ["/usr/local/bin/build-apps.sh"]


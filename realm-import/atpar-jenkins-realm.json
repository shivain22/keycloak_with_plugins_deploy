{
  "realm": "atpar-jenkins",
  "enabled": true,
  "displayName": "ATPAR Jenkins Realm",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "rememberMe": true,
  "sslRequired": "external",
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "loginTheme": "rms-auth-theme-plugin",
  "accountTheme": "rms-auth-theme-plugin",
  "adminTheme": "rms-auth-theme-plugin",
  "emailTheme": "rms-auth-theme-plugin",
  "roles": {
    "realm": [
      {
        "name": "jenkins-admin",
        "description": "Jenkins administrator role - full access to Jenkins"
      },
      {
        "name": "jenkins-developer",
        "description": "Jenkins developer role - can build and view jobs"
      },
      {
        "name": "jenkins-viewer",
        "description": "Jenkins viewer role - read-only access"
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Jenkins",
      "lastName": "Administrator",
      "email": "admin@atparui.com",
      "credentials": [
        {
          "type": "password",
          "value": "AzBy791833!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "jenkins-admin"
      ],
      "requiredActions": [],
      "attributes": {
        "skipPhoneVerification": ["true"]
      }
    }
  ],
  "clients": [
    {
      "clientId": "atpar-jenkins",
      "name": "ATPAR Jenkins Client",
      "description": "OIDC client for Jenkins CI/CD authentication",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "AtP4rJ3nK1nSS3cR3t2024SecureKey",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "baseUrl": "https://jenkins.atparui.com",
      "rootUrl": "https://jenkins.atparui.com",
      "adminUrl": "https://jenkins.atparui.com",
      "attributes": {
        "pkce.code.challenge.method": "",
        "access.token.lifespan": "1800",
        "post.logout.redirect.uris": "https://jenkins.atparui.com,http://localhost:8080"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "web-origins",
        "role_list",
        "roles",
        "jenkins-roles"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ],
      "webOrigins": [
        "https://jenkins.atparui.com",
        "http://localhost:8080",
        "*"
      ],
      "redirectUris": [
        "https://jenkins.atparui.com/securityRealm/finishLogin",
        "http://localhost:8080/securityRealm/finishLogin",
        "https://jenkins.atparui.com/*",
        "http://localhost:8080/*"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "openid",
      "description": "OpenID Connect scope for ID token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        },
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "sub",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "OpenID Connect built-in scope: profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${profileScopeConsentText}"
      },
      "protocolMappers": [
        {
          "name": "family name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "lastName",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "family_name",
            "jsonType.label": "String"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "fullName",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "name",
            "jsonType.label": "String"
          }
        },
        {
          "name": "given name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "firstName",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "given_name",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "OpenID Connect built-in scope: email",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${emailScopeConsentText}"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "emailVerified",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email_verified",
            "jsonType.label": "boolean"
          }
        }
      ]
    },
    {
      "name": "jenkins-roles",
      "description": "Custom scope to add roles as flat array in token claims for Jenkins",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "roles-array-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "user.attribute": "",
            "claim.name": "roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "openid",
    "profile",
    "email",
    "role_list",
    "roles",
    "web-origins",
    "acr",
    "jenkins-roles"
  ],
  "defaultOptionalClientScopes": [
    "offline_access",
    "address",
    "phone",
    "microprofile-jwt"
  ]
}

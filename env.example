# ===================================================================
# Complete Environment Configuration File
# Copy this file to `.env` (same directory) before running docker compose
# 
# Usage: cp env.example .env
# 
# This file contains ALL required values with correct defaults.
# Only update these if needed:
#   - MSG91_AUTH_KEY and MSG91_TEMPLATE_ID (if using MSG91)
#   - DOCKER_PASSWORD (your Docker Hub password)
#   - ENVIRONMENT=prod (for production deployment)
#   - Production URLs (if different from defaults)
# ===================================================================

# ===================================================================
# Keycloak Configuration
# ===================================================================
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak
KEYCLOAK_VERSION=26.4.7
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HTTP_PORT=9292

# Keycloak Database Configuration
POSTGRES_IMAGE=postgres
POSTGRES_VERSION=16
POSTGRES_PORT=5434
KC_DB_NAME=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak

# Keycloak Proxy/Reverse Proxy Configuration
KC_PROXY=xforwarded
KC_HOSTNAME=
KC_HOSTNAME_STRICT_HTTPS=false
KEYCLOAK_DISABLE_DEBUG=

# ===================================================================
# Artifact Builder Configuration
# ===================================================================
PHONE_PROVIDER_REPO_URL=https://github.com/shivain22/keycloak-phone-provider.git
PHONE_PROVIDER_BRANCH=master
THEME_REPO_URL=https://github.com/shivain22/rms-keycloakify-theme.git
THEME_BRANCH=main
THEME_JAR_NAME=keycloak-theme-for-kc-26.2-and-above.jar
GITHUB_TOKEN=

# ===================================================================
# SMS Provider Configuration
# ===================================================================
SMS_PROVIDER=msg91
SMS_TOKEN_EXPIRES=60
SMS_SOURCE_HOUR_MAX=10
SMS_TARGET_HOUR_MAX=3

# Phone Provider Configuration
DUPLICATE_PHONE=false
PHONE_REGEX=^\\+?\\d+$
VALID_PHONE=true
CANONICALIZE_PHONE=E164
PHONE_DEFAULT_REGION=IN
PHONE_COMPATIBLE=false
OTP_EXPIRES=3600

# MSG91 Configuration (UPDATE WITH YOUR ACTUAL VALUES)
MSG91_URL=https://control.msg91.com/api/v5/flow
MSG91_AUTH_KEY=CHANGE_ME
MSG91_TEMPLATE_ID=CHANGE_ME

# ===================================================================
# Apps Builder Configuration (Gateway and Service Docker Images)
# ===================================================================
GATEWAY_REPO_URL=https://github.com/shivain22/rms.git
GATEWAY_BRANCH=master
SERVICE_REPO_URL=https://github.com/shivain22/rms-service.git
SERVICE_BRANCH=master
DOCKER_USERNAME=shivain22
DOCKER_PASSWORD=Asd!@#123

# ===================================================================
# Gateway Service Configuration
# ===================================================================
GATEWAY_IMAGE=shivain22/rms-gateway
GATEWAY_VERSION=latest
GATEWAY_HTTP_PORT=9293
GATEWAY_PROFILE=prod

# Gateway Database Configuration
RMS_POSTGRES_IMAGE=postgres
RMS_POSTGRES_VERSION=15.4
RMS_POSTGRES_PORT=5435
RMS_DB_NAME=rms
RMS_DB_USERNAME=rms
RMS_DB_PASSWORD=rms

# Gateway OAuth2 Client Configuration
GATEWAY_REALM=gateway
GATEWAY_CLIENT_ID=gateway-web
GATEWAY_CLIENT_SECRET=M5nP8qR2sT6uV9wX1yZ3aC4dE7fG0h

# Gateway Keycloak Admin Client Configuration (required for realm management)
# Use internal docker service name for admin client (internal communication)
KEYCLOAK_ADMIN_SERVER_URL=http://keycloak:8080
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ===================================================================
# Service Configuration
# ===================================================================
SERVICE_IMAGE=shivain22/rms-service
SERVICE_VERSION=latest
SERVICE_HTTP_PORT=9294
SERVICE_PROFILE=prod

# Service OAuth2 Client Configuration
SERVICE_REALM=rms-service
SERVICE_CLIENT_ID=rms-service-web
SERVICE_CLIENT_SECRET=B1cD3eF5gH7iJ9kL1mN3oP5qR7sT9uV

# ===================================================================
# Environment and URL Configuration
# ===================================================================
ENVIRONMENT=local

# Local Development URLs (used when ENVIRONMENT=local)
GATEWAY_URL=http://localhost:9293
SERVICE_URL=http://localhost:9294
FRONTEND_URL=http://localhost:9000
KEYCLOAK_URL=http://localhost:9292

# Keycloak Issuer URI (used by Gateway and Service for OAuth2)
# For production, use the production URL
KEYCLOAK_ISSUER_URI=https://rmsauth.atparui.com/realms/gateway
KEYCLOAK_SERVICE_ISSUER_URI=https://rmsauth.atparui.com/realms/rms-service

# Production Subdomains (atparui.com)
GATEWAY_DOMAIN=rmsgateway.atparui.com
SERVICE_DOMAIN=rmsservice.atparui.com
DASHBOARD_DOMAIN=rmsdashboard.atparui.com
KEYCLOAK_DOMAIN=rmsauth.atparui.com

# Production URLs (HTTPS) - used when ENVIRONMENT=prod
GATEWAY_URL_PROD=https://rmsgateway.atparui.com
SERVICE_URL_PROD=https://rmsservice.atparui.com
DASHBOARD_URL_PROD=https://rmsdashboard.atparui.com
KEYCLOAK_URL_PROD=https://rmsauth.atparui.com

# ===================================================================
# Environment-Specific Configuration Examples
# ===================================================================
# 
# NOTE: Default values above are set for PRODUCTION (https://rmsauth.atparui.com)
# 
# For LOCAL development, update these:
# ENVIRONMENT=local
# GATEWAY_URL=http://localhost:9293
# SERVICE_URL=http://localhost:9294
# FRONTEND_URL=http://localhost:9000
# KEYCLOAK_URL=http://localhost:9292
# KEYCLOAK_ISSUER_URI=http://localhost:9292/realms/gateway
# KEYCLOAK_SERVICE_ISSUER_URI=http://localhost:9292/realms/rms-service
#
# For PRODUCTION (current defaults):
# ENVIRONMENT=prod
# GATEWAY_URL=https://rmsgateway.atparui.com
# SERVICE_URL=https://rmsservice.atparui.com
# FRONTEND_URL=https://rmsdashboard.atparui.com
# KEYCLOAK_URL=https://rmsauth.atparui.com
# KEYCLOAK_ISSUER_URI=https://rmsauth.atparui.com/realms/gateway
# KEYCLOAK_SERVICE_ISSUER_URI=https://rmsauth.atparui.com/realms/rms-service
# KC_HOSTNAME=rmsauth.atparui.com
# KC_HOSTNAME_STRICT_HTTPS=true
#

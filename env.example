# ===================================================================
# Complete Environment Configuration
# Copy this file to `.env` and update values as needed
# Usage: cp env.example .env
# ===================================================================

# ===================================================================
# Environment Selection
# ===================================================================
ENVIRONMENT=prod

# ===================================================================
# Keycloak Configuration
# ===================================================================
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak
KEYCLOAK_VERSION=26.4.7
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HTTP_PORT=9292
KC_PROXY=xforwarded
KC_HOSTNAME=
KC_HOSTNAME_STRICT_HTTPS=false
KEYCLOAK_DISABLE_DEBUG=

# ===================================================================
# Database Configuration (PostgreSQL 17)
# ===================================================================
POSTGRES_IMAGE=postgres
POSTGRES_VERSION=17
POSTGRES_PORT=5434
KC_DB_NAME=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak

# RMS Database Configuration
# PostgreSQL uses 'postgres' superuser to allow dynamic tenant database creation
# Gateway uses 'rms_gateway' database for master tables (tenants, platforms, etc.)
# Tenant databases are created dynamically by PlatformDatabaseInitializer
RMS_POSTGRES_PORT=5435

# PostgreSQL Admin Credentials (superuser for creating tenant databases)
POSTGRES_ADMIN_PASSWORD=postgres123

# Platform Database Admin Configuration
# Used by gateway to create tenant databases dynamically
PLATFORM_DB_ADMIN_HOST=rms-postgresql
PLATFORM_DB_ADMIN_PORT=5432
PLATFORM_DB_ADMIN_USER=postgres
PLATFORM_DB_ADMIN_DATABASE=postgres
PLATFORM_DB_INITIALIZE_ON_STARTUP=true
PLATFORM_DB_CREATE_DEMO_DATA=true

# ===================================================================
# Gateway Configuration
# ===================================================================
GATEWAY_IMAGE=shivain22/rms-gateway
GATEWAY_VERSION=latest
GATEWAY_HTTP_PORT=9293
GATEWAY_PROFILE=prod,api-docs
GATEWAY_REALM=gateway
GATEWAY_CLIENT_ID=gateway-web
GATEWAY_CLIENT_SECRET=M5nP8qR2sT6uV9wX1yZ3aC4dE7fG0h
# Build version info (automatically set during build, do not edit manually)
GATEWAY_BUILD_VERSION=
GATEWAY_BUILD_SHORT_VERSION=
GATEWAY_BUILD_COMMIT_HASH=
GATEWAY_BUILD_COMMIT_COUNT=
GATEWAY_BUILD_BRANCH=
GATEWAY_BUILD_TIMESTAMP=

# ===================================================================
# Service Configuration (rms-service - Multi-Tenant)
# ===================================================================
SERVICE_IMAGE=shivain22/rms-service
SERVICE_VERSION=latest
# Build version info (automatically set during build, do not edit manually)
SERVICE_BUILD_VERSION=
SERVICE_BUILD_SHORT_VERSION=
SERVICE_BUILD_COMMIT_HASH=
SERVICE_BUILD_COMMIT_COUNT=
SERVICE_BUILD_BRANCH=
SERVICE_BUILD_TIMESTAMP=
SERVICE_HTTP_PORT=9294
SERVICE_PROFILE=prod,api-docs

# ===================================================================
# Multi-Tenant Configuration for rms-service
# rms-service does NOT have its own static database.
# It fetches tenant database config from Gateway dynamically.
# ===================================================================
MULTI_TENANT_ENABLED=true
MULTI_TENANT_TENANT_ID_HEADER=X-Tenant-ID
MULTI_TENANT_JWT_TENANT_CLAIM=tenant_id
# Gateway URL for fetching tenant database config
MULTI_TENANT_GATEWAY_BASE_URL=http://gateway:8080
MULTI_TENANT_GATEWAY_TENANT_CONFIG_ENDPOINT=/api/tenants/{tenantId}/database-config
MULTI_TENANT_GATEWAY_CONNECTION_TIMEOUT=5000
MULTI_TENANT_GATEWAY_READ_TIMEOUT=10000
# Connection pool settings per tenant
MULTI_TENANT_CONNECTION_CACHE_TTL=3600
MULTI_TENANT_CONNECTION_MAX_POOL_SIZE=20
MULTI_TENANT_CONNECTION_MIN_POOL_SIZE=5
# Fallback configuration (use default tenant if no tenant header)
MULTI_TENANT_FALLBACK_ENABLED=false
MULTI_TENANT_FALLBACK_DEFAULT_TENANT_ID=rms_default

# ===================================================================
# Keycloak Admin Client (for Gateway/Service to manage realms)
# ===================================================================
KEYCLOAK_ADMIN_SERVER_URL=http://keycloak:8080
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ===================================================================
# OAuth2/OIDC Configuration
# ===================================================================
KEYCLOAK_ISSUER_URI=https://rmsauth.atparui.com/realms/gateway
KEYCLOAK_SERVICE_ISSUER_URI=https://rmsauth.atparui.com/realms/rms-service

# ===================================================================
# Infrastructure Services (Docker Service Names)
# ===================================================================
# Database - Gateway (uses database 'rms_gateway' with 'public' schema)
GATEWAY_DATASOURCE_URL=jdbc:postgresql://rms-postgresql:5432/rms_gateway
GATEWAY_DATASOURCE_USERNAME=rms_gateway
GATEWAY_DATASOURCE_PASSWORD=rms_gateway
GATEWAY_R2DBC_URL=r2dbc:postgresql://rms-postgresql:5432/rms_gateway
GATEWAY_R2DBC_USERNAME=rms_gateway
GATEWAY_R2DBC_PASSWORD=rms_gateway
GATEWAY_LIQUIBASE_URL=jdbc:postgresql://rms-postgresql:5432/rms_gateway?currentSchema=public
GATEWAY_LIQUIBASE_USER=rms_gateway
GATEWAY_LIQUIBASE_PASSWORD=rms_gateway
GATEWAY_LIQUIBASE_DEFAULT_SCHEMA=public

# ===================================================================
# DEPRECATED: Service Database Configuration
# rms-service no longer uses a single shared database.
# Instead, each tenant gets their own database created by the gateway.
# The service connects to tenant-specific databases using config from gateway.
# ===================================================================
# SERVICE_DATASOURCE_URL=jdbc:postgresql://rms-postgresql:5432/rms_service
# SERVICE_DATASOURCE_USERNAME=rms_service
# SERVICE_DATASOURCE_PASSWORD=rms_service

# Set to true to clear Liquibase checksums if changeset files were modified (one-time fix)
SPRING_LIQUIBASE_CLEAR_CHECK_SUMS=false

# Consul
SPRING_CLOUD_CONSUL_HOST=consul
SPRING_CLOUD_CONSUL_PORT=8500
CONSUL_PORT=8500
CONSUL_CONFIG_PATH=./consul-config

# Spring Cloud Consul Discovery Configuration
# Services will register with Consul using these settings
SPRING_CLOUD_CONSUL_DISCOVERY_ENABLED=true
SPRING_CLOUD_CONSUL_DISCOVERY_HEALTH_CHECK_PATH=/management/health/readiness
SPRING_CLOUD_CONSUL_DISCOVERY_HEALTH_CHECK_INTERVAL=10s
SPRING_CLOUD_CONSUL_DISCOVERY_HEALTH_CHECK_CRITICAL_TIMEOUT=30s
# If health checks fail due to tenant filter intercepting them, disable health checks:
# SPRING_CLOUD_CONSUL_DISCOVERY_REGISTER_HEALTH_CHECK=false
# Gateway service name in Consul (used for service discovery)
GATEWAY_SERVICE_NAME=gateway
# Service service name in Consul (used for service discovery)
SERVICE_SERVICE_NAME=rms-service

# OAuth2 Proxy for Consul UI Security
OAUTH2_PROXY_PORT=4180
OAUTH2_PROXY_CLIENT_ID=gateway-web
OAUTH2_PROXY_CLIENT_SECRET=M5nP8qR2sT6uV9wX1yZ3aC4dE7fG0h
OAUTH2_PROXY_OIDC_ISSUER_URL=https://rmsauth.atparui.com/realms/gateway
OAUTH2_PROXY_REDIRECT_URL=https://consul.atparui.com/oauth2/callback
OAUTH2_PROXY_COOKIE_SECRET=y390XIWJG1lBwekWGN57cZRx7BwDVlrOruVxReBw3es=
OAUTH2_PROXY_COOKIE_DOMAIN=consul.atparui.com
# Note: OAUTH2_PROXY_COOKIE_SECRET should be a random 32-byte string (base64 encoded)
# Generate with: openssl rand -base64 32
# Or with Python: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_PORT=9295
ZOOKEEPER_PORT=2181

# Elasticsearch
SPRING_ELASTICSEARCH_URIS=http://elasticsearch:9200
SPRING_DATA_ELASTICSEARCH_CLUSTER_NODES=elasticsearch:9200
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# Custom R2DBC config variables (used by MasterDatabaseConfig and MultiTenantDatabaseConfig)
# Gateway uses database 'rms_gateway' with 'public' schema
DB_HOST=rms-postgresql
DB_PORT=5432
DB_NAME=rms_gateway
DB_USERNAME=rms_gateway
DB_PASSWORD=rms_gateway

# ===================================================================
# Application URLs (Production)
# ===================================================================
GATEWAY_URL=https://rmsgateway.atparui.com
SERVICE_URL=https://rmsservice.atparui.com
FRONTEND_URL=https://rmsdashboard.atparui.com
KEYCLOAK_URL=https://rmsauth.atparui.com

# ===================================================================
# Build Configuration
# ===================================================================
GATEWAY_REPO_URL=https://github.com/shivain22/rms.git
GATEWAY_BRANCH=master
SERVICE_REPO_URL=https://github.com/shivain22/rms-service.git
SERVICE_BRANCH=master
DOCKER_USERNAME=shivain22
DOCKER_PASSWORD=Asd!@#123

# ===================================================================
# Keycloak Artifacts Build Configuration
# ===================================================================
PHONE_PROVIDER_REPO_URL=https://github.com/shivain22/keycloak-phone-provider.git
PHONE_PROVIDER_BRANCH=master
THEME_REPO_URL=https://github.com/atpar-org/rms-auth-theme-plugin.git
THEME_BRANCH=main
THEME_JAR_NAME=keycloak-theme-for-kc-26.2-and-above.jar
GITHUB_TOKEN=

# ===================================================================
# SMS Provider Configuration
# ===================================================================
SMS_PROVIDER=msg91
SMS_TOKEN_EXPIRES=60
SMS_SOURCE_HOUR_MAX=10
SMS_TARGET_HOUR_MAX=3
MSG91_URL=https://control.msg91.com/api/v5/flow
MSG91_AUTH_KEY=CHANGE_ME
MSG91_TEMPLATE_ID=CHANGE_ME

# Phone Provider Configuration
DUPLICATE_PHONE=false
PHONE_REGEX=^\\+?\\d+$
VALID_PHONE=true
CANONICALIZE_PHONE=E164
PHONE_DEFAULT_REGION=IN
PHONE_COMPATIBLE=false
OTP_EXPIRES=3600

# Copy this file to `.env` (same directory) before running `docker compose up`.
#
# Keycloak image
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak
KEYCLOAK_VERSION=26.4.7

# Keycloak admin user (development only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Host port to expose Keycloak on
# Changed to 9292 to avoid conflicts with other applications
KEYCLOAK_HTTP_PORT=9292

# Postgres image
POSTGRES_IMAGE=postgres
POSTGRES_VERSION=16

# Postgres port (exposed on host)
# Changed to 5434 to avoid conflicts (5432 and 5433 are commonly used)
POSTGRES_PORT=5434

# Database settings used by both Postgres and Keycloak
KC_DB_NAME=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak

# Debug Logging Configuration
# Debug logging is ENABLED by default
# Set KEYCLOAK_DISABLE_DEBUG=true to disable debug logging (sets log level to INFO)
KEYCLOAK_DISABLE_DEBUG=

# Proxy/Reverse Proxy Configuration (required when behind HTTPS reverse proxy)
# Set KC_PROXY to 'xforwarded' (for nginx, cloudflare, etc.) or 'forwarded' (for standard forwarded headers)
# Set KC_HOSTNAME to your public domain (e.g., rmsauth.atparui.com)
# Set KC_HOSTNAME_STRICT_HTTPS to 'true' to enforce HTTPS-only URLs
KC_PROXY=xforwarded
KC_HOSTNAME=
KC_HOSTNAME_STRICT_HTTPS=false

# Artifact builder (runs first, outputs JARs into ./providers which is mounted into Keycloak)
PHONE_PROVIDER_REPO_URL=https://github.com/shivain22/keycloak-phone-provider.git
PHONE_PROVIDER_BRANCH=master
THEME_REPO_URL=https://github.com/atpar-org/rms-auth-theme-plugin.git
THEME_BRANCH=main
THEME_JAR_NAME=keycloak-theme-for-kc-26.2-and-above.jar

# SMS Provider Configuration
SMS_PROVIDER=msg91
SMS_TOKEN_EXPIRES=60
SMS_SOURCE_HOUR_MAX=10
SMS_TARGET_HOUR_MAX=3

# Phone Provider Configuration (applies to realm "ujwal")
DUPLICATE_PHONE=false
PHONE_REGEX=^\\+?\\d+$
VALID_PHONE=true
CANONICALIZE_PHONE=E164
PHONE_DEFAULT_REGION=IN
PHONE_COMPATIBLE=false
OTP_EXPIRES=3600

# MSG91 Configuration (do NOT commit real keys)
MSG91_URL=https://control.msg91.com/api/v5/flow
MSG91_AUTH_KEY=CHANGE_ME
MSG91_TEMPLATE_ID=CHANGE_ME

# Apps Builder Configuration (Gateway and Service)
GATEWAY_REPO_URL=https://github.com/shivain22/rms.git
GATEWAY_BRANCH=master
SERVICE_REPO_URL=https://github.com/shivain22/rms-service.git
SERVICE_BRANCH=master
DOCKER_USERNAME=shivain22
DOCKER_PASSWORD=Asd!@#123

# Gateway Service Configuration
GATEWAY_IMAGE=shivain22/rms-gateway
GATEWAY_VERSION=latest
# Changed to 9293 to avoid conflicts with other applications
GATEWAY_HTTP_PORT=9293

# Service Configuration
SERVICE_IMAGE=shivain22/rms-service
SERVICE_VERSION=latest
# Changed to 9294 to avoid conflicts with other applications
SERVICE_HTTP_PORT=9294

# Business Database (RMS PostgreSQL) Configuration
RMS_POSTGRES_IMAGE=postgres
RMS_POSTGRES_VERSION=15.4
# Changed to 5435 to avoid conflicts (5432, 5433, 5434 are commonly used)
RMS_POSTGRES_PORT=5435
RMS_DB_NAME=rms
RMS_DB_USERNAME=rms
RMS_DB_PASSWORD=rms

# Environment Configuration (local|dev|staging|prod)
ENVIRONMENT=local

# Application URLs (used for Keycloak redirect URIs and web origins)
# For local: use localhost URLs (ports match the HTTP_PORT settings above)
# For dev/staging/prod: use your actual domain URLs
GATEWAY_URL=http://localhost:9293
SERVICE_URL=http://localhost:9294
FRONTEND_URL=http://localhost:9000
KEYCLOAK_URL=http://localhost:9292

# Production Subdomains (atparui.com)
# These will be added to redirect URIs, web origins, and CORS
GATEWAY_DOMAIN=rmsgateway.atparui.com
SERVICE_DOMAIN=rmsservice.atparui.com
DASHBOARD_DOMAIN=rmsdashboard.atparui.com
KEYCLOAK_DOMAIN=rmsauth.atparui.com

# Production URLs (HTTPS) - will be used in prod environment
# Ports will be configured via reverse proxy, so no ports in URLs
GATEWAY_URL_PROD=https://rmsgateway.atparui.com
SERVICE_URL_PROD=https://rmsservice.atparui.com
DASHBOARD_URL_PROD=https://rmsdashboard.atparui.com
KEYCLOAK_URL_PROD=https://rmsauth.atparui.com

# Keycloak Realm Configuration
GATEWAY_REALM=gateway
SERVICE_REALM=rms-service
KEYCLOAK_ISSUER_URI=http://localhost:9292/realms/gateway

# Gateway OAuth2 Client Configuration
GATEWAY_CLIENT_ID=gateway-web
GATEWAY_CLIENT_SECRET=M5nP8qR2sT6uV9wX1yZ3aC4dE7fG0h

# Service OAuth2 Client Configuration
SERVICE_CLIENT_ID=rms-service-web
SERVICE_CLIENT_SECRET=B1cD3eF5gH7iJ9kL1mN3oP5qR7sT9uV

# Spring Profiles
GATEWAY_PROFILE=prod
SERVICE_PROFILE=prod

# Example configurations for different environments:
# 
# LOCAL:
# ENVIRONMENT=local
# GATEWAY_URL=http://localhost:9293
# SERVICE_URL=http://localhost:9294
# FRONTEND_URL=http://localhost:9000
# KEYCLOAK_URL=http://localhost:9292
#
# DEV:
# ENVIRONMENT=dev
# GATEWAY_URL=https://gateway-dev.example.com
# SERVICE_URL=https://service-dev.example.com
# FRONTEND_URL=https://app-dev.example.com
# KEYCLOAK_URL=https://auth-dev.example.com
#
# STAGING:
# ENVIRONMENT=staging
# GATEWAY_URL=https://gateway-staging.example.com
# SERVICE_URL=https://service-staging.example.com
# FRONTEND_URL=https://app-staging.example.com
# KEYCLOAK_URL=https://auth-staging.example.com
#
# PROD:
# ENVIRONMENT=prod
# GATEWAY_URL=https://rmsgateway.atparui.com
# SERVICE_URL=https://rmsservice.atparui.com
# FRONTEND_URL=https://rmsdashboard.atparui.com
# KEYCLOAK_URL=https://rmsauth.atparui.com
# KC_HOSTNAME=rmsauth.atparui.com
# KC_HOSTNAME_STRICT_HTTPS=true


